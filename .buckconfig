[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  xbox360 = xenon-forge
  none = none
  rustc_bootstrap = rustc-bootstrap

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  buck = none

# The Xbox 360 target, standard library overlay, toolchain rules and
# xex-link come from xenon-forge at a pinned commit (DEVELOPING.md,
# Local changes to xenon-forge).
[external_cells]
  prelude = bundled
  xbox360 = git
  rustc_bootstrap = git

[external_cell_xbox360]
  git_origin = https://github.com/landaire/xenon-forge
  commit_hash = f369053666c0d56176c8fdefd7d87f3dcc168c63

[external_cell_rustc_bootstrap]
  git_origin = https://github.com/landaire-contrib/buck2-rustc-bootstrap
  commit_hash = 0f1673dc9abdef78697e31451ca4b0080bfe41e8

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default \
    target:xbox360//...->prelude//platforms:default

[build]
  execution_platforms = xbox360//platforms:execution

[project]
  ignore = .claude, .git, .jj, .tools, buck-out, target
