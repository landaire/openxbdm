#!/bin/sh
# Runs the Buck2 release that toolchains/buck2 pins through DotSlash from
# PATH or the copy that bootstrap.sh installs into .tools. Add this
# directory to PATH to run it as buck2.
set -eu

# Resolve links to this file so a link on PATH finds the repository.
self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
    /*) self=$target ;;
    *) self=$(dirname -- "$self")/$target ;;
    esac
done

root=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd)
local_dotslash=$root/.tools/bin/dotslash
if command -v dotslash >/dev/null 2>&1; then
    dotslash=$(command -v dotslash)
elif [ -x "$local_dotslash" ]; then
    dotslash=$local_dotslash
else
    "$root/bootstrap.sh"
    dotslash=$local_dotslash
fi

DOTSLASH_CACHE=$root/.tools/dotslash
export DOTSLASH_CACHE
exec "$dotslash" "$root/toolchains/buck2" "$@"
