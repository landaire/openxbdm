load("@xbox360//buck:rust.bzl", "release_tool", "rust_release")
load("@xbox360//buck:toolchains.bzl", "xbox360_toolchains")
load("@xbox360//buck:profiles.bzl", "profile_rustc_binary_flags", "profile_rustc_flags", "profile_xbox360_rustc_flags")
load(":rustfmt_release.bzl", "RUSTFMT_HOSTS")

xbox360_toolchains(
    # The prelude runs doctests through a wrapper (`--test-runtool`), and
    # rustdoc then runs merged edition 2024 doctests in one process.
    # Separate binaries run each doctest in its own process, as Cargo does.
    rustdoc_flags = [
        "-Zunstable-options",
        "--merge-doctests=no",
    ],
    rustc_binary_flags = profile_rustc_binary_flags(),
    rustc_flags = profile_rustc_flags(),
    # The console module (xbox360/BUCK) shares the console's memory with the
    # running title, so it is built for size in every profile, with panics
    # that trap without formatting a message. `xbox360_executable_core`
    # compiles it as one fat LTO module.
    xbox360_rustc_flags = ["-Cpanic=immediate-abort"] + profile_xbox360_rustc_flags(),
)

# The prelude validates both branches of its C++ default-dependency selector.
# The config//:none branch is not selected by this repository.
alias(
    name = "cxx_no_default_deps",
    actual = ":cxx",
    visibility = ["PUBLIC"],
)

# Downloaded only when something runs rustfmt.
rust_release(
    name = "rustfmt-nightly",
    components = ["rustc", "rustfmt-preview"],
    hosts = RUSTFMT_HOSTS,
)

# `buck2 run toolchains//:rustfmt -- ...` formats with the pinned nightly
# rustfmt, which accepts every option in .rustfmt.toml.
release_tool(
    name = "rustfmt",
    path = "bin/rustfmt",
    release = ":rustfmt-nightly",
    visibility = ["PUBLIC"],
)
