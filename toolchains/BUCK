load("@xbox360//buck:rust.bzl", "release_tool", "rust_release")
load("@xbox360//buck:toolchains.bzl", "xbox360_toolchains")
load(":rustfmt_release.bzl", "RUSTFMT_HOSTS")

# `-c rust.profile=release` builds host crates like Cargo's release profile
# (with the workspace's `lto = "thin"`), which also strips the standard
# library's debug information from executables. The dev profile uses
# rustc's defaults. Only binaries take -Clto: rustc rejects it for
# proc-macro crates, and libraries carry the bitcode that it uses.
_PROFILE_RUSTC_FLAGS = {
    "dev": [],
    "release": ["-Copt-level=3", "-Cstrip=debuginfo"],
}

_PROFILE_RUSTC_BINARY_FLAGS = {
    "dev": [],
    "release": ["-Clto=thin"],
}

_PROFILE = read_config("rust", "profile", "dev")

_PROFILE in _PROFILE_RUSTC_FLAGS or fail("rust.profile must be one of {}, not `{}`".format(_PROFILE_RUSTC_FLAGS.keys(), _PROFILE))

xbox360_toolchains(
    # The prelude runs doctests through a wrapper (`--test-runtool`), and
    # rustdoc then runs merged edition 2024 doctests in one process.
    # Separate binaries run each doctest in its own process, as Cargo does.
    rustdoc_flags = [
        "-Zunstable-options",
        "--merge-doctests=no",
    ],
    rustc_binary_flags = _PROFILE_RUSTC_BINARY_FLAGS[_PROFILE],
    rustc_flags = _PROFILE_RUSTC_FLAGS[_PROFILE],
    # The console module (xbox360/BUCK) shares the console's memory with the
    # running title, so it is built for size in every profile: one LTO
    # module, and panics that trap without formatting a message.
    xbox360_rustc_binary_flags = ["-Clto=fat"],
    xbox360_rustc_flags = ["-Cpanic=immediate-abort"],
)

# Downloaded only when something runs rustfmt.
rust_release(
    name = "rustfmt-nightly",
    components = ["rustc", "rustfmt-preview"],
    hosts = RUSTFMT_HOSTS,
)

# `buck2 run toolchains//:rustfmt -- ...` formats with the pinned nightly
# rustfmt, which accepts every option in .rustfmt.toml.
release_tool(
    name = "rustfmt",
    path = "bin/rustfmt",
    release = ":rustfmt-nightly",
    visibility = ["PUBLIC"],
)
