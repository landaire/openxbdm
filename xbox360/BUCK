load("@xbox360//buck:xex.bzl", "xex_from_assembly")

_MODULE = "//openxbdm/server/xbox360:openxbdm-server-xbox360"

# For the kd host (DEVELOPING.md, Console deployment).
xex_from_assembly(
    name = "openxbdm",
    executable = _MODULE + "-bin",
    manifest = "xex.toml",
    out = "openxbdm.xex",
    visibility = ["PUBLIC"],
)

# For DEVKIT:\FlashEx with the recovery marker check.
xex_from_assembly(
    name = "openxbdm-boot-guard",
    executable = _MODULE + "-boot-guard-bin",
    manifest = "xex.toml",
    out = "openxbdm-boot-guard.xex",
    visibility = ["PUBLIC"],
)

xex_from_assembly(
    name = "openxbdm-retail-dashlaunch",
    executable = _MODULE + "-retail-dashlaunch-bin",
    manifest = "xex-retail-dashlaunch.toml",
    out = "openxbdm-retail-dashlaunch.xex",
    visibility = ["PUBLIC"],
)

# Without the save and restore rewrite.
xex_from_assembly(
    name = "openxbdm-no-rewrite",
    executable = _MODULE + "-bin",
    manifest = "xex.toml",
    out = "openxbdm-no-rewrite.xex",
    rewrite = False,
)
